<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
        <edmx:Include Namespace="com.sap.vocabularies.Common.v1" Alias="Common"/>
    </edmx:Reference>
    <edmx:Reference Uri="/v2processor/$metadata">
        <edmx:Include Namespace="V2TravelService"/>
    </edmx:Reference>
    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="local.labels">
            <Annotations Target="V2TravelService.Travel/TravelID">
                <Annotation Term="Common.Label" String="{@i18n>travel}"/>
                <Annotation Term="Common.Text" Path="Description"></Annotation>
            </Annotations>
            <Annotations Target="V2TravelService.Travel/CustomerFullName">
                <Annotation Term="Common.Label" String="{@i18n>customer}"/>
            </Annotations>
            <Annotations Target="V2TravelService.Travel/BeginDate">
                <Annotation Term="Common.Label" String="{@i18n>startingDate}"/>
            </Annotations>
            <Annotations Target="V2TravelService.Travel/EndDate">
                <Annotation Term="Common.Label" String="{@i18n>endDate}"/>
            </Annotations>
            <Annotations Target="V2TravelService.Travel/BookingFee">
                <Annotation Term="Common.Label" String="{@i18n>bookingFee}"/>
            </Annotations>
            <Annotations Target="V2TravelService.Travel/TotalPrice">
                <Annotation Term="Common.Label" String="{@i18n>totalPrice}"/>
            </Annotations>
            <Annotations Target="V2TravelService.Travel/TravelStatus_code">
                <Annotation Term="Common.Label" String="{@i18n>travelStatus}"/>
            </Annotations>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>